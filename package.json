{
  "name": "pi-ssh-remote-multi",
  "version": "0.7.2",
  "description": "Persistent multi-server SSH workspaces for Pi.",
  "type": "module",
  "author": "Yutong Bian and contributors",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "ssh",
    "remote-development",
    "multi-server"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && node --import tsx test/endpoint-selector.ts && node --import tsx test/credentials.ts && node --import tsx test/password-prompt.ts",
    "pack:check": "npm run check && npm pack --dry-run"
  },
  "files": [
    "index.ts",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petrichor20211/pi-ssh-remote.git"
  },
  "homepage": "https://github.com/petrichor20211/pi-ssh-remote#readme",
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
